{
  "manifest_version": 3,
  "name": "TRN Match Finder",
  "version": "1.1.0",
  "description": "Find the Valorant matches a tracker.gg profile shared with any player.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TRN Match Finder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tracker.gg/valorant/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://api.tracker.gg/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "trn-match-finder@local.dev",
      "strict_min_version": "128.0"
    }
  }
}
